{
  "name": "signal-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI Trading Signal Content Automation Platform — Phase 1 MVP",
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "tsx watch src/api/server.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "start": "tsx src/api/server.ts",
    "build": "tsc -p tsconfig.json --noEmit && vite build --config apps/web/vite.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "render:golden": "tsx scripts/generate-golden.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.2.0",
    "@paralleldrive/cuid2": "^2.2.2",
    "better-sqlite3": "^11.10.0",
    "drizzle-orm": "^0.44.2",
    "fastify": "^5.3.3",
    "grammy": "^1.36.1",
    "openai": "^5.8.2",
    "pino": "^9.7.0",
    "playwright": "^1.53.1",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "concurrently": "^9.1.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
